<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>pluginsib-utils-ejb</artifactId>
    <packaging>jar</packaging>
    <name>PluginsIB - Utils - EJB</name>
    <parent>
        <groupId>org.fundaciobit.pluginsib.utils</groupId>
        <version>3.0.0-SNAPSHOT</version>
        <artifactId>pluginsib-utils</artifactId>
    </parent>
    <dependencies>

        <!-- API Java EE: proporciona javax.annotation (@PostConstruct, @Resource)
             i javax.ejb (TimerService, ScheduleExpression, @Timeout, etc.) -->
        <dependency>
            <groupId>javax</groupId>
            <artifactId>javaee-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Logging: org.jboss.logging.Logger (el proporciona el servidor WildFly/JBoss) -->
        <dependency>
            <groupId>org.jboss.logging</groupId>
            <artifactId>jboss-logging</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Anotacions esteses EJB3: org.jboss.ejb3.annotation.TransactionTimeout -->
        <dependency>
            <groupId>org.jboss.ejb3</groupId>
            <artifactId>jboss-ejb3-ext-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- GenApp: org.fundaciobit.genapp.common.i18n.I18NCommonDateTimeFormat -->
        <dependency>
            <groupId>org.fundaciobit.genapp</groupId>
            <artifactId>genapp-core</artifactId>
            <version>2.0.0-SNAPSHOT</version>
        </dependency>

    </dependencies>

</project>